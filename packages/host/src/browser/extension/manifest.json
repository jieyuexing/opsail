{
  "manifest_version": 3,
  "name": "Opsail Chrome",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Read bound Feishu and Teams sources through local Opsail scripts.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "scripting", "alarms"],
  "optional_host_permissions": ["https://*.feishu.cn/*", "https://teams.microsoft.com/*", "https://teams.microsoftonline.cn/*", "https://teams.cloud.microsoft/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_title": "Opsail Chrome", "default_popup": "options.html"},
  "options_page": "options.html",
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
